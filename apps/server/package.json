{
  "name": "@j-messenger/server",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:foundation": "tsc --noEmit -p tsconfig.foundation.json",
    "test": "vitest run --root .",
    "test:foundation": "vitest run --root . test/platform/config.test.ts test/platform/logging.test.ts",
    "check": "npm run typecheck && npm run test",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@j-messenger/contracts": "0.2.0",
    "fastify": "5.12.5",
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.5",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/websocket": "11.3.1",
    "@fastify/swagger": "9.9.1",
    "@fastify/multipart": "10.1.2",
    "@fastify/type-provider-typebox": "6.1.0",
    "typebox": "1.3.34",
    "pino": "10.3.1",
    "@j-auth/token-verifier": "0.1.0",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/ws": "8.18.2"
  }
}
