# Local development only. Do not use fixed development authentication as production mail authentication.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
AUTH_MODE=development-fixed
MAIL_SERVERS=dev-a,dev-b
FEATURE_FILES=true
FEATURE_RECEIPTS=true
FEATURE_RETENTION=true
FEATURE_NATIVE_SESSIONS=true
FEATURE_NOTIFICATIONS=false
FILE_QUOTA_BYTES=2000000000
SESSION_DAYS=7
LOG_LEVEL=info
