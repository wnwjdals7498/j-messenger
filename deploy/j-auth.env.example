# Cloud/customer internal service profile. Copy outside the checkout.
# PostgreSQL service profile. SQLite remains an explicit compatibility profile.
NODE_ENV=production
HOST=127.0.0.1
PORT=54250
PUBLIC_ORIGIN=https://127.0.0.1:54250
AUTH_MODE=j-auth
JAUTH_TENANT=__PLACEHOLDER_CUSTOMER_TENANT__
KC_PUBLIC_URL=https://auth.jgw.test
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://jgw_messenger:__PLACEHOLDER_DB_PASSWORD__@127.0.0.1:5432/jgw_messenger
DATABASE_SCHEMA=public
FILE_ROOT=/external/runtime/messenger/files
TEMP_ROOT=/external/runtime/messenger/temp
BACKUP_ROOT=/external/runtime/messenger/backups
WEB_DIST=/external/runtime/messenger/web-unused
TLS_CERT_PATH=/external/runtime/tls/messenger.crt
TLS_KEY_PATH=/external/runtime/tls/messenger.key
NODE_EXTRA_CA_CERTS=/external/runtime/tls/suite-ca-bundle.pem
CURSOR_SIGNING_KEY=__PLACEHOLDER_SECRET_AT_LEAST_32_CHARACTERS__
FEATURE_FILES=false
FEATURE_RECEIPTS=false
FEATURE_RETENTION=false
FEATURE_NATIVE_SESSIONS=false
FEATURE_NOTIFICATIONS=false
LOG_LEVEL=info
