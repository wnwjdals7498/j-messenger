{
  "name": "j-messenger",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check:contracts": "npm run check --workspace=@j-messenger/contracts",
    "build:contracts": "npm run build --workspace=@j-messenger/contracts",
    "check:foundation": "npm run typecheck:foundation --workspace=@j-messenger/server && npm run test:foundation --workspace=@j-messenger/server",
    "check:server": "npm run check --workspace=@j-messenger/server",
    "test:postgres": "node scripts/run-postgres-integration.mjs",
    "import:sqlite": "node apps/server/dist/bootstrap/import-main.js",
    "check:client": "npm run check --workspace=@j-messenger/client-core",
    "check:ui": "npm run check --workspace=@j-messenger/client-react",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "setup:vm": "node scripts/setup-vm.mjs",
    "test:deploy": "node --test tests/deploy/vm-profile.test.mjs",
    "check": "node scripts/check-workspace.mjs",
    "build": "node scripts/build-workspace.mjs",
    "dev:server": "npm run build && node scripts/dev-server.mjs",
    "start": "npm run start --workspace=@j-messenger/server",
    "dev:web": "npm run dev --workspace=@j-messenger/web",
    "lint": "eslint apps packages && node scripts/check-boundaries.mjs",
    "format:check": "prettier --check apps packages tsconfig.base.json"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "eslint": "10.11.0",
    "jose": "6.2.12",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "4.1.0"
  }
}
